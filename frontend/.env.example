# Lantern dashboard — local development environment
# Copy to .env.local:  cp .env.example .env.local

# ---- Demo mode ----
# When true: frontend runs standalone with realistic fake data (no backend needed).
# When false: frontend requires the Lantern API backend to be reachable.
NEXT_PUBLIC_DEMO=true

# ---- Backend API ----
# Used only when NEXT_PUBLIC_DEMO=false.
# Public URL of the API (e.g. http://localhost:80/api or https://your-host/api).
NEXT_PUBLIC_API_BASE_URL=

# ---- Auth ----
# This build has no accounts: the dashboard has no sign-in flow.
# Put your own auth (reverse proxy, VPN, SSH tunnel) in front of it if you
# expose it beyond localhost.

# ---- Branding ----
NEXT_PUBLIC_APP_NAME=Lantern
NEXT_PUBLIC_APP_TAGLINE=AI-driven offensive-security control plane
